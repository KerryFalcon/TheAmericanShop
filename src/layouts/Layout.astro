	@media (prefers-reduced-motion: reduce) {
		html {
			scroll-behavior: auto;
		}

		*, *::before, *::after {
			animation-duration: 0.001ms !important;
			animation-iteration-count: 1 !important;
			scroll-behavior: auto !important;
			transition-duration: 0.001ms !important;
		}

		.page-transition-wipe {
			display: none;
		}

		.startup-loader {
			display: none;
		}

		.neon-nav::before,
		.nav-logo-text::after,
		.nav-stars span {
			animation: none !important;
		}

		body.motion-enabled section.motion-section,
		body.motion-enabled .motion-reveal {
			opacity: 1;
			transform: none;
		}
	}
</style>

<script>
	const prefersReducedMotion = window.matchMedia('(prefers-reduced-motion: reduce)').matches;
	const loaderStartedAt = performance.now();
	const finishStartupLoader = () => {
		const minimumLoaderMs = prefersReducedMotion ? 0 : 850;
		const elapsed = performance.now() - loaderStartedAt;
		window.setTimeout(() => {
			document.body.classList.remove('is-loading');
			window.setTimeout(() => document.getElementById('startup-loader')?.remove(), 650);
		}, Math.max(0, minimumLoaderMs - elapsed));
	};

	window.addEventListener('load', finishStartupLoader, { once: true });
	window.setTimeout(finishStartupLoader, 2400);

	const transitionWipe = document.createElement('div');
	transitionWipe.className = 'page-transition-wipe';
	transitionWipe.setAttribute('aria-hidden', 'true');
	document.body.appendChild(transitionWipe);

	const runPageWipe = () => {
		if (prefersReducedMotion) return;
		transitionWipe.classList.add('active');
		window.setTimeout(() => transitionWipe.classList.remove('active'), 520);
	};
	// Scroll effect — darken nav on scroll
	const nav = document.getElementById('neon-nav');
	window.addEventListener('scroll', () => {
		if (window.scrollY > 40) {
			nav?.classList.add('scrolled');
		} else {
			nav?.classList.remove('scrolled');
		}
	});

	// Mobile hamburger toggle
	const toggle = document.querySelector('.nav-toggle');
	const links = document.querySelector('.nav-links');
	toggle?.addEventListener('click', () => {
		links?.classList.toggle('open');
	});
	// Close menu on link click (mobile)
	links?.querySelectorAll('a').forEach(a => {
		a.addEventListener('click', () => {
			links?.classList.remove('open');
		});
	});

	const navStars = [...document.querySelectorAll('.nav-stars span')];
	let activeStarTimers = [];
	const lightNavStars = () => {
		if (!navStars.length) return;

		activeStarTimers.forEach(clearTimeout);
		activeStarTimers = [];
		navStars.forEach(star => star.classList.remove('is-lit', 'is-dim'));

		const shuffledStars = [...navStars].sort(() => Math.random() - 0.5);
		const litCount = 3 + Math.floor(Math.random() * 3);

		shuffledStars.slice(0, litCount).forEach((star, index) => {
			const startDelay = index * 260 + Math.random() * 420;
			const onTimer = window.setTimeout(() => {
				star.classList.add('is-lit');
				activeStarTimers.push(window.setTimeout(() => {
					star.classList.remove('is-lit');
					star.classList.add('is-dim');
					activeStarTimers.push(window.setTimeout(() => {
						star.classList.remove('is-dim');
					}, 1400));
				}, 1500 + Math.random() * 900));
			}, startDelay);
			activeStarTimers.push(onTimer);
		});
	};

	if (!prefersReducedMotion) {
		lightNavStars();
		window.setInterval(lightNavStars, 3100);
	}

	const revealSelector = [
		'.kicker',
		'.eyebrow',
		'h1',
		'h2',
		'.lead',
		'.intro',
		'.actions',
		'.metrics li',
		'.products-toolbar',
		'.tas-product-card',
		'.pricing-one .card',
		'.location-one .map-card',
		'.contact-one .info-item',
		'.contact-one .form'
	].join(',');

	const setupMotion = () => {
		const sections = [...document.querySelectorAll('section')]
			.filter(section => !section.classList.contains('products-panel'));

		if (prefersReducedMotion) {
			sections.forEach(section => section.classList.add('is-visible'));
			return;
		}

		document.body.classList.add('motion-enabled');

		sections.forEach((section) => {
			section.classList.add('motion-section');

			const revealItems = [...section.querySelectorAll(revealSelector)];
			revealItems.forEach((item, index) => {
				item.classList.add('motion-reveal');
				item.style.setProperty('--reveal-delay', `${Math.min(index * 48, 300)}ms`);

				if (index % 3 === 1) item.classList.add('motion-slide-left');
				if (index % 3 === 2) item.classList.add('motion-slide-right');
			});
		});

		const sectionObserver = new IntersectionObserver((entries) => {
			entries.forEach((entry) => {
				entry.target.classList.toggle('is-visible', entry.isIntersecting);
			});
		}, {
			threshold: 0.18,
			rootMargin: '-8% 0px -12% 0px'
		});

		sections.forEach(section => sectionObserver.observe(section));
	};

	window.addEventListener('load', () => {
		window.setTimeout(setupMotion, prefersReducedMotion ? 0 : 120);
	});

	document.querySelectorAll('a[href^="#"]').forEach(anchor => {
		anchor.addEventListener('click', (event) => {
			const href = anchor.getAttribute('href');
			if (!href || href === '#') return;

			const target = document.querySelector(href);
			if (!target) return;

			event.preventDefault();
			runPageWipe();
			window.setTimeout(() => {
				history.pushState(null, '', href);
				target.scrollIntoView({ behavior: prefersReducedMotion ? 'auto' : 'smooth', block: 'start' });
			}, prefersReducedMotion ? 0 : 120);
		});
	});
</script>
