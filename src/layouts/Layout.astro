		.neon-nav {
			height: 70px !important;
			padding: 0 0.85rem !important;
			gap: 0.7rem !important;
		}
		.neon-nav.scrolled {
			height: 64px !important;
		}
		.nav-logo {
			min-width: 0 !important;
			gap: 0.62rem !important;
		}
		.nav-logo-img {
			width: 40px !important;
			height: 40px !important;
		}
		.nav-logo-text {
			max-width: calc(100vw - 116px) !important;
			overflow: hidden !important;
			text-overflow: ellipsis !important;
			white-space: nowrap !important;
			font-size: 1rem !important;
		}
		.nav-links {
			top: 70px !important;
			left: 0.85rem !important;
			right: 0.85rem !important;
			padding: 0.75rem !important;
		}
		.neon-nav.scrolled .nav-links,
		.neon-nav.scrolled ~ .nav-links {
			top: 64px !important;
		}
		.nav-links a {
			min-height: 44px !important;
			display: flex !important;
			align-items: center !important;
			justify-content: center !important;
		}
		h1, h2 {
			overflow-wrap: anywhere !important;
			hyphens: auto !important;
		}
	}

	@media (max-width: 430px) {
		.nav-logo-text {
			max-width: calc(100vw - 108px) !important;
			font-size: 0.94rem !important;
		}
	}

	/* ===== NEON SIGN HEADINGS ===== */
	h1, h2 {
		font-family: 'Quicksand', sans-serif !important;
		letter-spacing: 0.02em !important;
		color: #ff2fb3 !important;
		text-shadow:
			0 0 7px #ff2fb3,
			0 0 20px #ff2fb3,
			0 0 40px rgba(255,47,179,0.6),
			0 0 80px rgba(255,47,179,0.3),
			0 0 120px rgba(255,47,179,0.15) !important;
		animation: neon-flicker 4s ease-in-out infinite !important;
	}

	@keyframes neon-flicker {
		0%, 19%, 21%, 23%, 25%, 54%, 56%, 100% { opacity: 1; text-shadow: 0 0 7px #ff2fb3, 0 0 20px #ff2fb3, 0 0 40px rgba(255,47,179,0.6), 0 0 80px rgba(255,47,179,0.3); }
		20%, 24% { opacity: 0.6; text-shadow: 0 0 4px #ff2fb3, 0 0 10px rgba(255,47,179,0.4); }
		55% { opacity: 0.8; text-shadow: 0 0 5px #ff2fb3, 0 0 15px rgba(255,47,179,0.5); }
	}


	@keyframes nav-title-shine {
		0%, 42% { transform: translateX(-130%) skewX(-16deg); opacity: 0; }
		50% { opacity: 0.88; }
		62%, 100% { transform: translateX(130%) skewX(-16deg); opacity: 0; }
	}

	/* ===== HIDE OLD CHECKERED STRIPS ===== */
	.checker-strip-top, .checker-strip-bottom {
		display: none !important;
	}

	/* ===== NEON LINE DIVIDERS between sections ===== */
	section::after {
		content: "" !important;
		display: block !important;
		width: 100% !important;
		height: 2px !important;
		background: linear-gradient(90deg, transparent, #ff2fb3 20%, #ff2fb3 80%, transparent) !important;
		box-shadow: 0 0 8px #ff2fb3, 0 0 20px rgba(255,47,179,0.4) !important;
		position: absolute !important;
		bottom: 0 !important;
		left: 0 !important;
		z-index: 10 !important;
	}
	section:last-child::after {
		display: none !important;
	}

	/* ========================================
	   HERO — Brick wall + neon sign
	   ======================================== */
	.hero-one {
		background:
			radial-gradient(ellipse 90% 70% at 50% 50%, rgba(255,47,179,0.14), transparent 60%),
			radial-gradient(ellipse 60% 50% at 20% 30%, rgba(249,248,113,0.06), transparent 50%),
			radial-gradient(ellipse 50% 40% at 80% 70%, rgba(0,216,255,0.05), transparent 50%),
			linear-gradient(rgba(0,0,0,0.45), rgba(0,0,0,0.45)),
			url('/background2.jpeg') !important;
		background-size: auto, auto, auto, auto, cover !important;
		background-position: center !important;
		color: #f0ece8 !important;
		padding: clamp(5rem,10vw,8rem) clamp(2rem,6vw,6rem) !important;
	}
	.hero-one .kicker {
		color: #f9f871 !important;
		background: rgba(249,248,113,0.08) !important;
		border: 1px solid rgba(249,248,113,0.25) !important;
		border-radius: 999px; padding: 0.4rem 1rem;
		font-weight: 800; text-transform: uppercase; letter-spacing: 0.3em; font-size: 0.75rem;
		display: inline-block;
		text-shadow: 0 0 8px rgba(249,248,113,0.4);
	}
	.hero-one h1 {
		font-size: clamp(2.8rem,6vw,5rem) !important;
		line-height: 1.05 !important;
	}
	.hero-one .lead {
		color: rgba(240,236,232,0.7) !important;
		font-size: clamp(1rem,1.8vw,1.15rem);
		max-width: 50ch; line-height: 1.7;
	}
	.hero-one .btn-primary {
		background: #ff2fb3 !important;
		color: #fff !important;
		border: none !important;
		padding: 0.9rem 2rem; border-radius: 999px; font-weight: 800;
		box-shadow: 0 0 16px rgba(255,47,179,0.6), 0 0 40px rgba(255,47,179,0.3) !important;
		text-decoration: none;
		transition: box-shadow 0.3s, transform 0.2s;
	}
	.hero-one .btn-primary:hover {
		box-shadow: 0 0 24px rgba(255,47,179,0.8), 0 0 60px rgba(255,47,179,0.4) !important;
		transform: translateY(-2px);
	}
	.hero-one .btn-ghost {
		border: 2px solid rgba(240,236,232,0.3) !important;
		color: #f0ece8 !important;
		background: rgba(240,236,232,0.04) !important;
		padding: 0.9rem 2rem; border-radius: 999px; font-weight: 800;
		text-decoration: none;
	}
	.hero-one .logo-neon {
		filter: drop-shadow(0 0 20px rgba(255,47,179,0.9)) drop-shadow(0 0 50px rgba(255,47,179,0.5)) !important;
	}
	.hero-one .hero-visual {
		position: relative !important;
	}
	/* === NEON AURA — inner glow, rotates + pulses === */
	.hero-one .hero-visual::before {
		content: "" !important;
		display: block !important;
		position: absolute !important;
		top: 50%; left: 50%;
		width: 420px; height: 420px;
		border-radius: 50% !important;
		background:
			conic-gradient(
				from 0deg,
				rgba(255,47,179,0.7),
				rgba(0,212,255,0.4),
				rgba(255,230,0,0.3),
				rgba(255,47,179,0.7),
				rgba(0,212,255,0.4),
				rgba(255,47,179,0.7)
			) !important;
		filter: blur(40px) !important;
		z-index: 0 !important;
		pointer-events: none !important;
		animation: aura-spin 6s linear infinite !important;
	}
	/* === NEON AURA — outer glow, counter-rotates + breathes === */
	.hero-one .hero-visual::after {
		content: "" !important;
		display: block !important;
		position: absolute !important;
		top: 50%; left: 50%;
		width: 520px; height: 520px;
		border-radius: 50% !important;
		background:
			conic-gradient(
				from 180deg,
				rgba(255,47,179,0.3),
				rgba(255,230,0,0.12),
				rgba(0,212,255,0.2),
				rgba(255,47,179,0.3),
				rgba(255,230,0,0.12),
				rgba(255,47,179,0.3)
			) !important;
		filter: blur(60px) !important;
		z-index: 0 !important;
		pointer-events: none !important;
		animation: aura-spin-reverse 8s linear infinite !important;
	}
	@keyframes aura-spin {
		0% { transform: translate(-50%, -50%) rotate(0deg) scale(1); }
		50% { transform: translate(-50%, -50%) rotate(180deg) scale(1.08); }
		100% { transform: translate(-50%, -50%) rotate(360deg) scale(1); }
	}
	@keyframes aura-spin-reverse {
		0% { transform: translate(-50%, -50%) rotate(0deg) scale(1.05); }
		50% { transform: translate(-50%, -50%) rotate(-180deg) scale(0.95); }
		100% { transform: translate(-50%, -50%) rotate(-360deg) scale(1.05); }
	}
	/* === Neon ring — glowing tube around logo === */
	.hero-one .logo-ring {
		background: transparent !important;
		border: 4px solid rgba(255,47,179,0.7) !important;
		box-shadow:
			0 0 8px rgba(255,47,179,0.8),
			0 0 20px rgba(255,47,179,0.6),
			0 0 45px rgba(255,47,179,0.35),
			0 0 90px rgba(255,47,179,0.2),
			0 0 140px rgba(255,47,179,0.1),
			inset 0 0 20px rgba(255,47,179,0.2),
			inset 0 0 50px rgba(255,47,179,0.08) !important;
	}
	/* === Logo image — circular with its own glow === */
	.hero-one .logo-neon {
		border-radius: 50% !important;
		filter:
			drop-shadow(0 0 10px rgba(255,47,179,0.6))
			drop-shadow(0 0 30px rgba(255,47,179,0.3))
			drop-shadow(0 0 60px rgba(255,47,179,0.15)) !important;
	}

	/* === FLOATING PRODUCTS around logo — NO overlap === */
	.float-product {
		position: absolute !important;
		z-index: 3 !important;
		pointer-events: none !important;
		background: transparent !important;
		border: none !important;
		box-shadow: none !important;
		outline: none !important;
		padding: 0 !important;
		isolation: isolate !important;
	}
	.float-product::before {
		content: "" !important;
		position: absolute !important;
		inset: 14% !important;
		z-index: -1 !important;
		border-radius: 999px !important;
		background: radial-gradient(circle, rgba(255,47,179,0.28) 0%, rgba(0,216,255,0.12) 42%, transparent 72%) !important;
		filter: blur(12px) !important;
		opacity: 0.65 !important;
		pointer-events: none !important;
	}
	.float-product img {
		width: 70px !important;
		height: auto !important;
		object-fit: contain !important;
		background: transparent !important;
		border: none !important;
		box-shadow: none !important;
		outline: none !important;
		filter: drop-shadow(0 0 7px rgba(255,47,179,0.34)) drop-shadow(0 4px 10px rgba(0,0,0,0.42)) !important;
	}
	/* All products start at center, then translate out to a circle radius of 220px */
	.hero-one .hero-visual { overflow: visible !important; }
	.float-product {
		top: 50% !important;
		left: 50% !important;
	}
	/* 10 items at 36° intervals on a 220px radius circle */
	/* cos/sin values: 0°(0,-1) 36°(.59,-.81) 72°(.95,-.31) 108°(.95,.31) 144°(.59,.81) 180°(0,1) 216°(-.59,.81) 252°(-.95,.31) 288°(-.95,-.31) 324°(-.59,-.81) */
	.fp1  { animation: fp1-orbit  5.0s ease-in-out infinite alternate !important; }
	.fp2  { animation: fp2-orbit  6.0s ease-in-out infinite alternate !important; }
	.fp3  { animation: fp3-orbit  5.5s ease-in-out infinite alternate !important; }
	.fp4  { animation: fp4-orbit  7.0s ease-in-out infinite alternate !important; }
	.fp5  { animation: fp5-orbit  6.5s ease-in-out infinite alternate !important; }
	.fp6  { animation: fp6-orbit  5.8s ease-in-out infinite alternate !important; }
	.fp7  { animation: fp7-orbit  6.2s ease-in-out infinite alternate !important; }
	.fp8  { animation: fp8-orbit  5.3s ease-in-out infinite alternate !important; }
	.fp9  { animation: fp9-orbit  6.8s ease-in-out infinite alternate !important; }
	.fp10 { animation: fp10-orbit 5.6s ease-in-out infinite alternate !important; }

	/* Wide organic spread — ~300-320px radius */
	@keyframes fp1-orbit {
		0%   { transform: translate(-50%, calc(-50% - 240px)) rotate(-12deg); }
		100% { transform: translate(-50%, calc(-50% - 252px)) rotate(-5deg); }
	}
	@keyframes fp2-orbit {
		0%   { transform: translate(calc(-50% + 210px), calc(-50% - 195px)) rotate(10deg); }
		100% { transform: translate(calc(-50% + 205px), calc(-50% - 208px)) rotate(18deg); }
	}
	@keyframes fp3-orbit {
		0%   { transform: translate(calc(-50% + 310px), calc(-50% - 50px)) rotate(-15deg); }
		100% { transform: translate(calc(-50% + 305px), calc(-50% - 65px)) rotate(-8deg); }
	}
	@keyframes fp4-orbit {
		0%   { transform: translate(calc(-50% + 300px), calc(-50% + 130px)) rotate(14deg); }
		100% { transform: translate(calc(-50% + 295px), calc(-50% + 115px)) rotate(8deg); }
	}
	@keyframes fp5-orbit {
		0%   { transform: translate(calc(-50% + 190px), calc(-50% + 205px)) rotate(-10deg); }
		100% { transform: translate(calc(-50% + 185px), calc(-50% + 218px)) rotate(-18deg); }
	}
	@keyframes fp6-orbit {
		0%   { transform: translate(calc(-50% + 10px), calc(-50% + 245px)) rotate(8deg); }
		100% { transform: translate(calc(-50% + 5px), calc(-50% + 258px)) rotate(15deg); }
	}
	@keyframes fp7-orbit {
		0%   { transform: translate(calc(-50% - 200px), calc(-50% + 200px)) rotate(-14deg); }
		100% { transform: translate(calc(-50% - 195px), calc(-50% + 213px)) rotate(-6deg); }
	}
	@keyframes fp8-orbit {
		0%   { transform: translate(calc(-50% - 305px), calc(-50% + 65px)) rotate(12deg); }
		100% { transform: translate(calc(-50% - 300px), calc(-50% + 50px)) rotate(5deg); }
	}
	@keyframes fp9-orbit {
		0%   { transform: translate(calc(-50% - 310px), calc(-50% - 75px)) rotate(-8deg); }
		100% { transform: translate(calc(-50% - 305px), calc(-50% - 90px)) rotate(-16deg); }
	}
	@keyframes fp10-orbit {
		0%   { transform: translate(calc(-50% - 205px), calc(-50% - 190px)) rotate(10deg); }
		100% { transform: translate(calc(-50% - 200px), calc(-50% - 203px)) rotate(4deg); }
	}

	@media (max-width: 768px) {
		.hero-one .hero-visual {
			overflow: visible !important;
		}
		.hero-one .float-product {
			display: block !important;
			z-index: 3 !important;
		}
		.hero-one .float-product::before {
			inset: 18% !important;
			filter: blur(9px) !important;
			opacity: 0.45 !important;
		}
		.hero-one .fp1  { animation-name: fp1-orbit-mobile !important; }
		.hero-one .fp2  { animation-name: fp2-orbit-mobile !important; }
		.hero-one .fp3  { animation-name: fp3-orbit-mobile !important; }
		.hero-one .fp4  { animation-name: fp4-orbit-mobile !important; }
		.hero-one .fp5  { animation-name: fp5-orbit-mobile !important; }
		.hero-one .fp6  { animation-name: fp6-orbit-mobile !important; }
		.hero-one .fp7  { animation-name: fp7-orbit-mobile !important; }
		.hero-one .fp8  { animation-name: fp8-orbit-mobile !important; }
		.hero-one .fp9  { animation-name: fp9-orbit-mobile !important; }
		.hero-one .fp10 { animation-name: fp10-orbit-mobile !important; }
	}

	@keyframes fp1-orbit-mobile {
		0%   { transform: translate(-50%, calc(-50% - 142px)) rotate(-12deg); }
		100% { transform: translate(-50%, calc(-50% - 152px)) rotate(-5deg); }
	}
	@keyframes fp2-orbit-mobile {
		0%   { transform: translate(calc(-50% + 104px), calc(-50% - 122px)) rotate(10deg); }
		100% { transform: translate(calc(-50% + 98px), calc(-50% - 130px)) rotate(18deg); }
	}
	@keyframes fp3-orbit-mobile {
		0%   { transform: translate(calc(-50% + 146px), calc(-50% - 35px)) rotate(-15deg); }
		100% { transform: translate(calc(-50% + 138px), calc(-50% - 46px)) rotate(-8deg); }
	}
	@keyframes fp4-orbit-mobile {
		0%   { transform: translate(calc(-50% + 132px), calc(-50% + 68px)) rotate(14deg); }
		100% { transform: translate(calc(-50% + 124px), calc(-50% + 58px)) rotate(8deg); }
	}
	@keyframes fp5-orbit-mobile {
		0%   { transform: translate(calc(-50% + 76px), calc(-50% + 132px)) rotate(-10deg); }
		100% { transform: translate(calc(-50% + 68px), calc(-50% + 140px)) rotate(-18deg); }
	}
	@keyframes fp6-orbit-mobile {
		0%   { transform: translate(calc(-50% - 8px), calc(-50% + 148px)) rotate(8deg); }
		100% { transform: translate(calc(-50% - 14px), calc(-50% + 138px)) rotate(15deg); }
	}
	@keyframes fp7-orbit-mobile {
		0%   { transform: translate(calc(-50% - 88px), calc(-50% + 126px)) rotate(-14deg); }
		100% { transform: translate(calc(-50% - 96px), calc(-50% + 134px)) rotate(-6deg); }
	}
	@keyframes fp8-orbit-mobile {
		0%   { transform: translate(calc(-50% - 132px), calc(-50% + 50px)) rotate(12deg); }
		100% { transform: translate(calc(-50% - 142px), calc(-50% + 42px)) rotate(5deg); }
	}
	@keyframes fp9-orbit-mobile {
		0%   { transform: translate(calc(-50% - 144px), calc(-50% - 40px)) rotate(-8deg); }
		100% { transform: translate(calc(-50% - 136px), calc(-50% - 52px)) rotate(-16deg); }
	}
	@keyframes fp10-orbit-mobile {
		0%   { transform: translate(calc(-50% - 94px), calc(-50% - 124px)) rotate(10deg); }
		100% { transform: translate(calc(-50% - 86px), calc(-50% - 134px)) rotate(4deg); }
	}

	/* === IVY VINE CORNERS === */
	.ivy-corners {
		position: absolute !important;
		inset: 0 !important;
		z-index: 10 !important;
		pointer-events: none !important;
		overflow: hidden !important;
	}
	.ivy-corner {
		position: absolute !important;
		width: 200px !important;
		height: auto !important;
		opacity: 0.85 !important;
	}
	.ivy-tl { top: 0; left: 0; }
	.ivy-tr { top: 0; right: 0; transform: scaleX(-1) !important; }
	.ivy-bl { bottom: 0; left: 0; transform: scaleY(-1) !important; }
	.ivy-br { bottom: 0; right: 0; transform: scale(-1, -1) !important; }

	.hero-one .metrics li {
		background: rgba(50,30,45,0.6) !important;
		border: 1px solid rgba(255,47,179,0.15) !important;
		border-radius: 16px; padding: 1.2rem;
		box-shadow: 0 0 12px rgba(255,47,179,0.05) !important;
		text-align: center;
	}
	.hero-one .metrics li:hover {
		border-color: rgba(255,47,179,0.4) !important;
		box-shadow: 0 0 20px rgba(255,47,179,0.1) !important;
	}
	.hero-one .metrics strong {
		font-family: 'Quicksand', sans-serif !important;
		font-size: 1.6rem !important;
		color: #ff2fb3 !important;
		text-shadow: 0 0 10px rgba(255,47,179,0.5) !important;
	}
	.hero-one .metrics span {
		color: rgba(240,236,232,0.5) !important;
		font-size: 0.85rem;
	}
	.hero-one .blob, .hero-one .glow-ring {
		opacity: 0.35 !important;
	}
	.hero-one .confetti { display: none !important; }

	/* ========================================
	   GALLERY — Dark charcoal, clean
	   ======================================== */
	.gallery-one {
		background:
			radial-gradient(ellipse 80% 60% at 30% 40%, rgba(255,47,179,0.12), transparent 55%),
			radial-gradient(ellipse 60% 50% at 75% 60%, rgba(0,216,255,0.08), transparent 50%),
			linear-gradient(180deg, #1c1825 0%, #1a1622 50%, #181420 100%) !important;
		color: #f0ece8 !important;
		padding: clamp(4rem,7vw,6rem) clamp(2rem,6vw,6rem) !important;
	}
	.gallery-one .eyebrow {
		color: #ff2fb3 !important;
		background: transparent !important;
		border: none !important;
		font-weight: 800; text-transform: uppercase; letter-spacing: 0.2em; font-size: 0.78rem;
		text-shadow: 0 0 6px rgba(255,47,179,0.4);
	}
	.gallery-one .intro { color: rgba(240,236,232,0.6) !important; }
	.gallery-one .item {
		background: rgba(30,25,40,0.5) !important;
		border: 2px solid rgba(255,47,179,0.12) !important;
		border-radius: 16px !important;
		box-shadow: 0 4px 20px rgba(0,0,0,0.4) !important;
		transition: all 0.3s !important;
	}
	.gallery-one .item:hover {
		border-color: #ff2fb3 !important;
		box-shadow: 0 0 24px rgba(255,47,179,0.2), 0 8px 30px rgba(0,0,0,0.4) !important;
		transform: scale(1.03) translateY(-4px) !important;
	}
	.gallery-one .caption {
		text-shadow: 0 0 8px rgba(255,47,179,0.4) !important;
	}

	/* ========================================
	   PRICING — Deep purple gradient
	   ======================================== */
	.pricing-one {
		background:
			radial-gradient(ellipse 70% 55% at 50% 30%, rgba(255,47,179,0.15), transparent 55%),
			radial-gradient(ellipse 50% 45% at 80% 80%, rgba(0,216,255,0.1), transparent 50%),
			radial-gradient(ellipse 40% 35% at 15% 70%, rgba(249,248,113,0.05), transparent 50%),
			linear-gradient(160deg, #241535 0%, #1e1230 40%, #1a0f28 100%) !important;
		color: #f0ece8 !important;
		padding: clamp(4rem,7vw,6rem) clamp(2rem,6vw,6rem) !important;
	}
	.pricing-one .eyebrow {
		color: #00d8ff !important;
		background: transparent !important;
		border: none !important;
		text-shadow: 0 0 8px rgba(0,216,255,0.4);
	}
	.pricing-one .intro { color: rgba(240,236,232,0.6) !important; }
	.pricing-one .card {
		background: rgba(40,28,60,0.55) !important;
		backdrop-filter: blur(12px); -webkit-backdrop-filter: blur(12px);
		border: 1px solid rgba(240,236,232,0.1) !important;
		border-radius: 20px !important;
		box-shadow: 0 4px 24px rgba(0,0,0,0.4) !important;
		color: #f0ece8 !important;
	}
	.pricing-one .card:hover {
		border-color: rgba(0,216,255,0.4) !important;
		box-shadow: 0 0 20px rgba(0,216,255,0.1), 0 8px 30px rgba(0,0,0,0.4) !important;
		transform: translateY(-6px) !important;
