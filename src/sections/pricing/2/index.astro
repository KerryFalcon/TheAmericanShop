<!--
  PRICING VARIANT 2 — Tabla comparativa horizontal
  ===================================================
  Estilo: Tabla de comparacion de planes con filas de features y checkmarks.

  ELEMENTOS A SUSTITUIR:
  ┌──────────────────────────────────────────────────────────────┐
  │ .eyebrow         → Texto corto de categoria/etiqueta         │
  │ h2               → Titulo principal de la seccion             │
  │ .intro           → Parrafo descriptivo de apoyo              │
  │ thead th         → Nombre de cada plan (x3)                  │
  │ .plan-price      → Precio de cada plan (x3)                  │
  │ tbody td:first   → Nombre de cada feature (filas)            │
  │ tbody td         → ✓ o ✗ segun disponibilidad               │
  │ tfoot a          → Texto + href del CTA de cada plan (x3)   │
  └──────────────────────────────────────────────────────────────┘
-->

<section class="pricing-two">
  <div class="header">
    <!-- EYEBROW: Etiqueta superior corta -->
    <p class="eyebrow">Lorem Ipsum</p>
