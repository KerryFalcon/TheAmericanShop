<!--
  PRICING VARIANT 3 — Toggle mensual/anual con cards minimalistas
  ==================================================================
  Estilo: Toggle decorativo arriba, tarjetas minimalistas con borde de acento.

  ELEMENTOS A SUSTITUIR:
  ┌──────────────────────────────────────────────────────────────┐
  │ .eyebrow         → Texto corto de categoria/etiqueta         │
  │ h2               → Titulo principal de la seccion             │
  │ .toggle label    → Texto de cada opcion del toggle (x2)      │
  │ .card .plan      → Nombre del plan (x3)                      │
  │ .card .desc      → Descripcion corta del plan (x3)           │
  │ .card .price     → Precio del plan (x3)                      │
  │ .card .period    → Periodo de facturacion (x3)               │
  │ .card li         → Caracteristica incluida (x3-5 por card)   │
  │ .card a          → Texto + href del CTA (x3)                 │
  └──────────────────────────────────────────────────────────────┘
-->

<section class="pricing-three">
  <div class="header">
    <!-- EYEBROW: Etiqueta superior corta -->
    <p class="eyebrow">Lorem Ipsum</p>
    <!-- TITULO: Headline principal -->
    <h2>Totam rem aperiam eaque ipsa quae ab illo</h2>
  </div>

  <!-- TOGGLE: Decorativo, agregar JS para cambiar precios -->
  <div class="toggle">
    <span class="active">Lorem</span>
    <span class="pill"></span>
    <span>Ipsum</span>
  </div>

  <div class="cards">
    <!-- PLAN 1 -->
    <div class="card">
      <div class="card-top">
        <p class="plan">Lorem</p>
        <p class="desc">Consectetur adipiscing elit sed do.</p>
        <p class="price">$0<span class="period">/lorem</span></p>
      </div>
      <ul>
        <li>Eiusmod tempor incididunt</li>
        <li>Ut labore et dolore</li>
        <li>Magna aliqua ut enim</li>
      </ul>
      <a href="#">Lorem Ipsum</a>
    </div>

    <!-- PLAN 2 -->
    <div class="card accent">
      <div class="card-top">
        <p class="plan">Ipsum</p>
        <p class="desc">Ut enim ad minim veniam quis nostrud.</p>
        <p class="price">$39<span class="period">/lorem</span></p>
      </div>
      <ul>
        <li>Exercitation ullamco laboris</li>
        <li>Nisi ut aliquip ex ea</li>
        <li>Commodo consequat duis</li>
        <li>Aute irure dolor in</li>
      </ul>
      <a href="#">Dolor Sit</a>
    </div>

    <!-- PLAN 3 -->
    <div class="card">
      <div class="card-top">
        <p class="plan">Dolor</p>
        <p class="desc">Excepteur sint occaecat cupidatat non.</p>
        <p class="price">$149<span class="period">/lorem</span></p>
      </div>
      <ul>
        <li>Reprehenderit voluptate velit</li>
        <li>Esse cillum dolore eu</li>
        <li>Fugiat nulla pariatur</li>
        <li>Sunt in culpa qui officia</li>
        <li>Deserunt mollit anim id</li>
      </ul>
      <a href="#">Amet Elit</a>
    </div>
  </div>
</section>

<style>
  .pricing-three {
    padding: clamp(3rem, 6vw, 5rem);
    background: #08080e;
    color: #e2e8f0;
  }

  .header {
    text-align: center;
    max-width: 550px;
    margin: 0 auto 1.5rem;
  }

  .eyebrow {
    margin: 0;
    text-transform: uppercase;
    letter-spacing: 0.14em;
    font-size: 0.78rem;
    font-weight: 700;
    color: #fbbf24;
  }

  h2 {
    margin: 0.4rem 0 0;
    font-size: clamp(1.8rem, 4vw, 2.8rem);
    line-height: 1.1;
    color: #f1f5f9;
  }

  .toggle {
    display: flex;
    align-items: center;
    justify-content: center;
    gap: 0.6rem;
    margin-bottom: 2.5rem;
    font-size: 0.88rem;
    font-weight: 600;
    color: #94a3b8;
  }

  .toggle .active {
    color: #fbbf24;
  }

  .pill {
    display: inline-block;
    width: 44px;
    height: 24px;
    border-radius: 999px;
    background: rgba(251, 191, 36, 0.2);
    border: 1px solid rgba(251, 191, 36, 0.35);
    position: relative;
    cursor: pointer;
  }

  .pill::after {
    content: '';
    position: absolute;
    top: 3px;
    left: 3px;
    width: 16px;
    height: 16px;
    border-radius: 50%;
    background: #fbbf24;
    transition: transform 0.2s;
  }

  .cards {
    display: grid;
    grid-template-columns: repeat(3, 1fr);
    gap: 1rem;
    max-width: 1000px;
    margin: 0 auto;
    align-items: start;
  }

  .card {
    border: 1px solid rgba(251, 191, 36, 0.1);
    border-radius: 20px;
    padding: 0;
    overflow: hidden;
    background: rgba(15, 23, 42, 0.3);
    transition: transform 0.2s, border-color 0.2s;
  }

  .card:hover {
    transform: translateY(-3px);
    border-color: rgba(251, 191, 36, 0.3);
  }

  .card.accent {
    border-color: rgba(251, 191, 36, 0.4);
    border-width: 2px;
  }

  .card-top {
    padding: 1.5rem 1.5rem 1rem;
    border-bottom: 1px solid rgba(251, 191, 36, 0.08);
  }

  .plan {
    margin: 0;
    font-size: 0.82rem;
    text-transform: uppercase;
    letter-spacing: 0.12em;
    font-weight: 700;
    color: #fbbf24;
  }

  .desc {
    margin: 0.2rem 0 0.6rem;
    font-size: 0.85rem;
    color: #94a3b8;
  }

  .price {
    margin: 0;
    font-size: 2.4rem;
    font-weight: 800;
    color: #f1f5f9;
  }

  .period {
    font-size: 0.85rem;
    font-weight: 500;
    color: #64748b;
  }

  ul {
    list-style: none;
    padding: 1rem 1.5rem;
    margin: 0;
    display: grid;
    gap: 0.45rem;
  }

  li {
    font-size: 0.88rem;
    color: #94a3b8;
    padding-left: 1.2rem;
    position: relative;
  }

  li::before {
    content: '✓';
    position: absolute;
    left: 0;
    color: #fbbf24;
    font-weight: 700;
    font-size: 0.8rem;
  }

  .card a {
    display: block;
    text-decoration: none;
    text-align: center;
    margin: 0 1.5rem 1.5rem;
    padding: 0.7rem;
    border-radius: 12px;
    font-weight: 700;
    font-size: 0.9rem;
    color: #fbbf24;
    border: 1px solid rgba(251, 191, 36, 0.25);
    background: transparent;
    transition: background 0.2s;
  }

  .card.accent a {
    background: #fbbf24;
    color: #422006;
    border-color: #fbbf24;
  }

  .card a:hover {
    background: rgba(251, 191, 36, 0.12);
  }

  @media (max-width: 768px) {
    .cards {
      grid-template-columns: 1fr;
      max-width: 400px;
    }
  }
</style>
