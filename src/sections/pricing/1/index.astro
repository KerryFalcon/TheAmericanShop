<!--
  PRICING VARIANT 1 — Tres columnas clasicas
  =============================================
  Estilo: 3 tarjetas de precio lado a lado, la del centro destacada.

  ELEMENTOS A SUSTITUIR:
  ┌──────────────────────────────────────────────────────────────┐
  │ .eyebrow         → Texto corto de categoria/etiqueta         │
  │ h2               → Titulo principal de la seccion             │
  │ .intro           → Parrafo descriptivo de apoyo              │
  │ .card .plan      → Nombre del plan (x3)                      │
  │ .card .price     → Precio del plan (x3)                      │
  │ .card .period    → Periodo de facturacion (x3)               │
  │ .card li         → Caracteristica incluida (x4 por card)     │
  │ .card a          → Texto + href del CTA (x3)                 │
  │ .badge           → Texto del badge "popular" (solo 1)        │
  └──────────────────────────────────────────────────────────────┘
-->

<section class="pricing-one">
  <div class="header">
    <!-- EYEBROW: Etiqueta superior corta -->
    <p class="eyebrow">Lorem Ipsum</p>
    <!-- TITULO: Headline principal -->
    <h2>Quis autem vel eum iure reprehenderit</h2>
    <!-- INTRO: Parrafo de apoyo -->
    <p class="intro">Lorem ipsum dolor sit amet, consectetur adipiscing elit. Sed do eiusmod tempor incididunt.</p>
  </div>

  <div class="cards">
    <!-- PLAN 1: Basico -->
    <div class="card">
      <p class="plan">Lorem</p>
      <p class="price">$19<span class="period">/lorem</span></p>
      <ul>
        <li>Consectetur adipiscing elit</li>
        <li>Sed do eiusmod tempor</li>
        <li>Incididunt ut labore</li>
        <li>Dolore magna aliqua</li>
      </ul>
      <a href="#">Lorem Ipsum</a>
    </div>

    <!-- PLAN 2: Popular (destacado) -->
    <div class="card featured">
      <span class="badge">Lorem</span>
      <p class="plan">Ipsum</p>
      <p class="price">$49<span class="period">/lorem</span></p>
      <ul>
        <li>Ut enim ad minim veniam</li>
        <li>Quis nostrud exercitation</li>
        <li>Ullamco laboris nisi</li>
        <li>Aliquip ex ea commodo</li>
      </ul>
      <a href="#">Dolor Sit</a>
    </div>

    <!-- PLAN 3: Premium -->
    <div class="card">
      <p class="plan">Dolor</p>
      <p class="price">$99<span class="period">/lorem</span></p>
      <ul>
        <li>Duis aute irure dolor</li>
        <li>Reprehenderit voluptate</li>
        <li>Cillum dolore eu fugiat</li>
        <li>Excepteur sint occaecat</li>
      </ul>
      <a href="#">Amet Elit</a>
    </div>
  </div>
</section>

<style>
  .pricing-one {
    padding: clamp(3rem, 6vw, 5rem);
    background: linear-gradient(180deg, #0a0a0f 0%, #0f172a 100%);
    color: #e2e8f0;
  }

  .header {
    text-align: center;
    max-width: 600px;
    margin: 0 auto 3rem;
  }

  .eyebrow {
    margin: 0;
    text-transform: uppercase;
    letter-spacing: 0.14em;
    font-size: 0.78rem;
    font-weight: 700;
    color: #818cf8;
  }

  h2 {
    margin: 0.4rem 0;
    font-size: clamp(1.8rem, 4vw, 2.8rem);
    line-height: 1.1;
    color: #f1f5f9;
  }

  .intro {
    margin: 0;
    color: #94a3b8;
  }

  .cards {
    display: grid;
    grid-template-columns: repeat(3, 1fr);
    gap: 1rem;
    max-width: 1000px;
    margin: 0 auto;
    align-items: start;
  }

  .card {
    background: rgba(15, 23, 42, 0.5);
    border: 1px solid rgba(129, 140, 248, 0.12);
    border-radius: 20px;
    padding: 2rem 1.5rem;
    text-align: center;
    position: relative;
    transition: transform 0.2s, border-color 0.2s;
  }

  .card:hover {
    transform: translateY(-3px);
    border-color: rgba(129, 140, 248, 0.35);
  }

  .card.featured {
    background: rgba(99, 102, 241, 0.12);
    border-color: rgba(129, 140, 248, 0.4);
    transform: scale(1.04);
  }

  .card.featured:hover {
    transform: scale(1.04) translateY(-3px);
  }

  .badge {
    position: absolute;
    top: -10px;
    left: 50%;
    transform: translateX(-50%);
    background: #6366f1;
    color: #fff;
    font-size: 0.7rem;
    font-weight: 800;
    text-transform: uppercase;
    letter-spacing: 0.1em;
    padding: 0.25rem 0.8rem;
    border-radius: 999px;
  }

  .plan {
    margin: 0;
    font-size: 0.9rem;
    font-weight: 700;
    text-transform: uppercase;
    letter-spacing: 0.1em;
    color: #a5b4fc;
  }

  .price {
    margin: 0.3rem 0 1rem;
    font-size: 2.8rem;
    font-weight: 800;
    color: #f1f5f9;
  }

  .period {
    font-size: 0.9rem;
    font-weight: 500;
    color: #64748b;
  }

  ul {
    list-style: none;
    padding: 0;
    margin: 0 0 1.5rem;
    display: grid;
    gap: 0.5rem;
  }

  li {
    font-size: 0.9rem;
    color: #94a3b8;
    padding: 0.4rem 0;
    border-bottom: 1px solid rgba(129, 140, 248, 0.08);
  }

  .card a {
    display: inline-block;
    text-decoration: none;
    background: rgba(99, 102, 241, 0.15);
    color: #a5b4fc;
    padding: 0.7rem 1.5rem;
    border-radius: 999px;
    font-weight: 700;
    border: 1px solid rgba(129, 140, 248, 0.25);
    transition: background 0.2s;
  }

  .card.featured a {
    background: #6366f1;
    color: #fff;
    border-color: #6366f1;
  }

  .card a:hover {
    background: rgba(99, 102, 241, 0.3);
  }

  @media (max-width: 768px) {
    .cards {
      grid-template-columns: 1fr;
      max-width: 400px;
    }

    .card.featured {
      transform: none;
    }
  }
</style>
