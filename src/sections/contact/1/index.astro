<!--
  CONTACT — Pop Urban Neon Dark
-->

<section class="contact-one" id="contact">
  <div class="contact-glow contact-glow-pink" aria-hidden="true"></div>
  <div class="contact-glow contact-glow-blue" aria-hidden="true"></div>
  <div class="contact-glow contact-glow-yellow" aria-hidden="true"></div>

  <div class="contact-inner">
    <div class="contact-header">
      <span class="eyebrow">✦ Contáctanos</span>
      <h2>Hablemos de tu próximo antojo</h2>
      <p class="intro">
        Escríbenos por el canal que prefieras, te ayudamos a encontrar tus snacks favoritos
        y traemos pedidos especiales bajo encargo.
      </p>
    </div>

    <div class="contact-grid">
      <aside class="contact-info">
        <article class="info-card">
          <span class="info-icon" aria-hidden="true">
            <svg viewBox="0 0 24 24" width="20" height="20" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round">
              <path d="M4 4h16c1.1 0 2 .9 2 2v12c0 1.1-.9 2-2 2H4c-1.1 0-2-.9-2-2V6c0-1.1.9-2 2-2z" />
              <polyline points="22,6 12,13 2,6" />
            </svg>
          </span>
          <div class="info-body">
            <span class="info-label">Email</span>
            <a class="info-value" href="mailto:hola@theamericanshop.mx">hola@theamericanshop.mx</a>
          </div>
        </article>

        <article class="info-card info-card-featured">
          <span class="info-icon" aria-hidden="true">
            <svg viewBox="0 0 24 24" width="20" height="20" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round">
              <path d="M22 16.92v3a2 2 0 0 1-2.18 2 19.79 19.79 0 0 1-8.63-3.07 19.5 19.5 0 0 1-6-6 19.79 19.79 0 0 1-3.07-8.67A2 2 0 0 1 4.11 2h3a2 2 0 0 1 2 1.72 12.84 12.84 0 0 0 .7 2.81 2 2 0 0 1-.45 2.11L8.09 9.91a16 16 0 0 0 6 6l1.27-1.27a2 2 0 0 1 2.11-.45 12.84 12.84 0 0 0 2.81.7A2 2 0 0 1 22 16.92z" />
            </svg>
          </span>
          <div class="info-body">
            <span class="info-label">WhatsApp</span>
            <a class="info-value" href="https://wa.me/521234567890" target="_blank" rel="noopener">+52 (123) 456-7890</a>
            <span class="info-meta">Respondemos en menos de 24 hrs</span>
          </div>
        </article>

        <article class="info-card">
          <span class="info-icon" aria-hidden="true">
            <svg viewBox="0 0 24 24" width="20" height="20" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round">
              <path d="M21 10c0 7-9 13-9 13s-9-6-9-13a9 9 0 0 1 18 0z" />
              <circle cx="12" cy="10" r="3" />
            </svg>
          </span>
          <div class="info-body">
            <span class="info-label">Tienda física</span>
            <span class="info-value">Querétaro, México</span>
            <span class="info-meta">Envíos a todo el país</span>
          </div>
        </article>
      </aside>

      <form class="form" action="#" method="POST">
        <span class="form-corner form-corner-tl" aria-hidden="true"></span>
        <span class="form-corner form-corner-br" aria-hidden="true"></span>

        <header class="form-head">
          <span class="form-kicker">✦ Envíanos un mensaje</span>
          <h3>Cuéntanos qué buscas</h3>
        </header>

        <div class="field">
          <label for="contact-name">Tu nombre</label>
          <input type="text" id="contact-name" name="name" placeholder="¿Cómo te llamas?" />
        </div>

        <div class="field-row">
          <div class="field">
            <label for="contact-email">Email</label>
            <input type="email" id="contact-email" name="email" placeholder="tu@email.com" />
          </div>
          <div class="field">
            <label for="contact-phone">Teléfono</label>
            <input type="tel" id="contact-phone" name="phone" placeholder="(55) 1234 5678" />
          </div>
        </div>

        <div class="field">
          <label for="contact-message">¿Qué necesitas?</label>
          <textarea id="contact-message" name="message" rows="4" placeholder="Cuéntanos qué productos buscas o describe tu pedido..."></textarea>
        </div>

        <button type="submit">
          <span>Enviar mensaje</span>
          <svg class="btn-arrow" viewBox="0 0 24 24" width="18" height="18" aria-hidden="true">
            <path d="M5 12h14M13 6l6 6-6 6" fill="none" stroke="currentColor" stroke-width="2.4" stroke-linecap="round" stroke-linejoin="round" />
          </svg>
        </button>
      </form>
    </div>
  </div>
</section>

<style>
  .contact-one {
    position: relative;
    overflow: hidden;
    isolation: isolate;
