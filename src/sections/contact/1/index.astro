<!--
  CONTACT VARIANT 1 — Formulario de contacto
  =============================================
  Estilo: Fondo oscuro con formulario centrado y datos de contacto laterales.

  ELEMENTOS A SUSTITUIR:
  ┌──────────────────────────────────────────────────────────────┐
  │ .eyebrow         → Texto corto de categoria/etiqueta         │
  │ h2               → Titulo principal de la seccion             │
  │ .intro           → Parrafo descriptivo de apoyo              │
  │ .info-item h3    → Titulo de cada dato de contacto (x3)      │
  │ .info-item p     → Detalle de cada dato de contacto (x3)     │
  │ form labels      → Etiquetas de cada campo del formulario    │
  │ form button      → Texto del boton de envio                  │
  │ form action      → URL destino del formulario                │
  └──────────────────────────────────────────────────────────────┘
-->

<section class="contact-one">
  <div class="wrapper">
    <div class="info">
      <!-- EYEBROW: Etiqueta superior corta -->
      <p class="eyebrow">Lorem Ipsum</p>

      <!-- TITULO: Headline principal de la seccion -->
      <h2>Consectetur adipiscing elit sed do eiusmod</h2>

      <!-- INTRO: Parrafo de apoyo -->
      <p class="intro">
        Lorem ipsum dolor sit amet, consectetur adipiscing elit. Sed do eiusmod tempor incididunt
        ut labore et dolore magna aliqua.
      </p>

      <!-- DATOS DE CONTACTO: Bloques informativos -->
      <div class="info-items">
        <div class="info-item">
          <!-- DATO 1: Titulo + detalle -->
          <h3>Lorem Ipsum</h3>
          <p>lorem@ipsum.com</p>
        </div>
        <div class="info-item">
          <!-- DATO 2: Titulo + detalle -->
          <h3>Dolor Sit</h3>
          <p>+1 (234) 567-8900</p>
        </div>
        <div class="info-item">
          <!-- DATO 3: Titulo + detalle -->
          <h3>Amet Consectetur</h3>
          <p>Lorem Ipsum 123, Dolor Sit, Amet 45678</p>
        </div>
      </div>
    </div>

    <!-- FORMULARIO: Cambiar action, campos y boton -->
    <form class="form" action="#" method="POST">
      <div class="field">
        <label for="contact-name">Lorem Ipsum</label>
        <input type="text" id="contact-name" name="name" placeholder="Dolor sit amet" />
      </div>
      <div class="field">
        <label for="contact-email">Consectetur</label>
        <input type="email" id="contact-email" name="email" placeholder="lorem@ipsum.com" />
      </div>
      <div class="field">
        <label for="contact-message">Adipiscing Elit</label>
        <textarea id="contact-message" name="message" rows="4" placeholder="Sed do eiusmod tempor..."></textarea>
      </div>
      <!-- BOTON: Texto del CTA de envio -->
      <button type="submit">Lorem Ipsum</button>
    </form>
  </div>
</section>

<style>
  .contact-one {
    padding: clamp(3rem, 6vw, 5rem);
    background: linear-gradient(180deg, #111827 0%, #0a0a0f 100%);
    color: #e2e8f0;
  }

  .wrapper {
    display: grid;
    grid-template-columns: 1fr 1fr;
    gap: 2.5rem;
    align-items: start;
    max-width: 1100px;
    margin: 0 auto;
  }

  .eyebrow {
    margin: 0;
    text-transform: uppercase;
    letter-spacing: 0.14em;
    font-size: 0.78rem;
    font-weight: 700;
    color: #5eead4;
  }

  h2 {
    margin: 0.5rem 0;
    font-size: clamp(1.8rem, 4vw, 2.8rem);
    line-height: 1.1;
    color: #f1f5f9;
  }

  .intro {
    margin: 0 0 1.5rem;
    color: #94a3b8;
    max-width: 50ch;
  }

  .info-items {
    display: grid;
    gap: 1rem;
  }

  .info-item {
    padding: 0.8rem;
    border: 1px solid rgba(94, 234, 212, 0.18);
    border-radius: 12px;
    background: rgba(15, 23, 42, 0.5);
  }

  .info-item h3 {
    margin: 0;
    font-size: 0.9rem;
    color: #5eead4;
  }

  .info-item p {
    margin: 0.2rem 0 0;
    color: #94a3b8;
    font-size: 0.92rem;
  }

  .form {
    display: grid;
    gap: 1rem;
    background: rgba(15, 23, 42, 0.6);
    border: 1px solid rgba(94, 234, 212, 0.15);
    border-radius: 18px;
    padding: 1.5rem;
  }

  .field {
    display: grid;
    gap: 0.3rem;
  }

  label {
    font-size: 0.85rem;
    font-weight: 600;
    color: #cbd5e1;
  }

  input,
  textarea {
    background: rgba(2, 6, 23, 0.6);
    border: 1px solid rgba(94, 234, 212, 0.2);
    border-radius: 10px;
    padding: 0.7rem 0.9rem;
    color: #f1f5f9;
    font-family: inherit;
    font-size: 0.95rem;
    outline: none;
    transition: border-color 0.2s ease;
  }

  input:focus,
  textarea:focus {
    border-color: #5eead4;
  }

  textarea {
    resize: vertical;
  }

  button {
    background: #5eead4;
    color: #022c22;
    border: none;
    border-radius: 999px;
    padding: 0.8rem 1.2rem;
    font-weight: 700;
    font-size: 1rem;
    cursor: pointer;
    transition: transform 0.2s ease;
  }

  button:hover {
    transform: translateY(-2px);
  }

  @media (max-width: 768px) {
    .wrapper {
      grid-template-columns: 1fr;
    }
  }
</style>
