<!--
  GALLERY VARIANT 1 — Grid masonry con lightbox placeholder
  ============================================================
  Estilo: Grid de imagenes tipo masonry con diferentes alturas, hover con overlay.

  ELEMENTOS A SUSTITUIR:
  ┌──────────────────────────────────────────────────────────────┐
  │ .eyebrow         → Texto corto de categoria/etiqueta         │
  │ h2               → Titulo principal de la seccion             │
  │ .intro           → Parrafo descriptivo de apoyo              │
  │ .item            → Sustituir fondo por <img> real (x8)       │
  │ .item .caption   → Titulo/descripcion de cada imagen (x8)    │
  │                    Agregar o quitar items segun necesidad     │
  └──────────────────────────────────────────────────────────────┘
-->

<section class="gallery-one">
  <div class="header">
    <!-- EYEBROW: Etiqueta superior corta -->
    <p class="eyebrow">Lorem Ipsum</p>
    <!-- TITULO: Headline principal -->
    <h2>Sed ut perspiciatis unde omnis iste natus error</h2>
    <!-- INTRO: Parrafo de apoyo -->
    <p class="intro">Lorem ipsum dolor sit amet, consectetur adipiscing elit. Ut enim ad minim veniam.</p>
  </div>

  <!-- GRID MASONRY: Cada .item es una imagen con caption -->
  <div class="masonry">
    <div class="item tall">
      <span class="caption">Lorem Ipsum Dolor</span>
    </div>
    <div class="item">
      <span class="caption">Amet Consectetur</span>
    </div>
    <div class="item">
      <span class="caption">Adipiscing Elit</span>
    </div>
    <div class="item wide">
      <span class="caption">Sed Do Eiusmod Tempor</span>
    </div>
    <div class="item tall">
      <span class="caption">Incididunt Labore</span>
    </div>
    <div class="item">
      <span class="caption">Dolore Magna</span>
    </div>
    <div class="item">
      <span class="caption">Ut Enim Veniam</span>
    </div>
    <div class="item wide">
      <span class="caption">Quis Nostrud Exercitation</span>
    </div>
  </div>
</section>

<style>
  .gallery-one {
    padding: clamp(3rem, 6vw, 5rem);
    background: #08080e;
    color: #e2e8f0;
  }

  .header {
    max-width: 600px;
    margin-bottom: 2.5rem;
  }

  .eyebrow {
    margin: 0;
    text-transform: uppercase;
    letter-spacing: 0.14em;
    font-size: 0.78rem;
    font-weight: 700;
    color: #fb923c;
  }

  h2 {
    margin: 0.4rem 0;
    font-size: clamp(1.8rem, 4vw, 2.8rem);
    line-height: 1.1;
    color: #f1f5f9;
  }

  .intro {
    margin: 0;
    color: #94a3b8;
  }

  .masonry {
    display: grid;
    grid-template-columns: repeat(4, 1fr);
    grid-auto-rows: 140px;
    gap: 0.75rem;
  }

  .item {
    position: relative;
    border-radius: 14px;
    overflow: hidden;
    background: linear-gradient(135deg, rgba(251, 146, 60, 0.12), rgba(234, 88, 12, 0.06));
    border: 1px solid rgba(251, 146, 60, 0.15);
    cursor: pointer;
    transition: transform 0.25s ease, border-color 0.25s ease;
  }

  .item:hover {
    transform: scale(1.02);
    border-color: rgba(251, 146, 60, 0.45);
  }

  .item.tall {
    grid-row: span 2;
  }

  .item.wide {
    grid-column: span 2;
  }

  .caption {
    position: absolute;
    bottom: 0;
    left: 0;
    right: 0;
    padding: 0.8rem;
    background: linear-gradient(transparent, rgba(8, 8, 14, 0.85));
    font-size: 0.85rem;
    font-weight: 600;
    color: #fed7aa;
    opacity: 0;
    transform: translateY(4px);
    transition: opacity 0.25s, transform 0.25s;
  }

  .item:hover .caption {
    opacity: 1;
    transform: translateY(0);
  }

  @media (max-width: 768px) {
    .masonry {
      grid-template-columns: repeat(2, 1fr);
      grid-auto-rows: 120px;
    }
  }
</style>
